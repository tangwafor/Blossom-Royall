{
  "name": "blossom-royall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "next build && node scripts/build-sites.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "sync:africstyle": "node scripts/sync-africstyle-public-catalog.mjs",
    "prepush": "npm run release:guard && npm run typecheck && npm run build:sites && npm run test:role-isolation && npm run test:vendor-rent && npm run test:owner-vendor-parity && npm run test:training-runbook && npm run test:monitor && npm run test:deletion-processor && npm run test:customer-commerce && npm run test:return-workflow && npm run test:fulfillment && npm run test:payment-verification && npm run test:cash-checkout && npm run test:cash-drawer && npm run test:operating-settings && npm run native:verify && npm test",
    "release:guard": "node scripts/fleet-release-guard.mjs",
    "release:guard:fix": "node scripts/fleet-release-guard.mjs --fix",
    "test:release-guard": "node scripts/fleet-release-guard-test.mjs",
    "monitor:production": "node scripts/synthetic-monitor.mjs",
    "test:monitor": "node scripts/synthetic-monitor-test.mjs",
    "test:deletion-processor": "node scripts/verify-account-deletion-processor.mjs",
    "test:customer-commerce": "node scripts/verify-customer-commerce.mjs",
    "test:return-workflow": "node scripts/verify-return-workflow.mjs",
    "test:fulfillment": "node scripts/verify-fulfillment-workflow.mjs",
    "test:payment-verification": "node scripts/verify-payment-verification.mjs",
    "test:cash-checkout": "node scripts/verify-cash-checkout.mjs",
    "test:cash-drawer": "node scripts/verify-cash-drawer.mjs",
    "test:operating-settings": "node scripts/verify-store-operating-settings.mjs",
    "test:role-isolation": "node scripts/verify-role-isolation.mjs",
    "test:vendor-rent": "node scripts/verify-vendor-rent-workflow.mjs",
    "test:owner-vendor-parity": "node scripts/verify-owner-vendor-parity.mjs",
    "test:backend-roles": "node scripts/run-credential-backend-tests.mjs",
    "release:credentials": "npm run test:backend-roles && npm run typecheck && npm run build && node scripts/run-credential-release-ui.mjs",
    "test:training-runbook": "node scripts/verify-role-training.mjs",
    "training:record": "node scripts/record-role-training.mjs",
    "training:vendor:ephemeral": "node scripts/run-ephemeral-vendor-training.mjs",
    "training:owner:ephemeral": "node scripts/run-ephemeral-owner-training.mjs",
    "native:sync": "npm run build:sites && node scripts/run-capacitor.cjs sync",
    "native:doctor": "node scripts/run-capacitor.cjs doctor",
    "native:verify": "node scripts/verify-native-readiness.mjs",
    "native:capture-assets": "node scripts/capture-store-assets.mjs",
    "native:verify-assets": "node scripts/verify-store-assets.mjs",
    "verify:public": "npm run build:sites && node scripts/verify-public-build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "tar": "7.5.22",
    "uuid": "14.0.2"
  }
